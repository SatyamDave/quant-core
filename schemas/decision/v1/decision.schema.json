{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-core.local/schemas/decision/v1/decision.schema.json",
  "title": "Decision",
  "description": "Agent output. confidence is advisory only; the Rust risk engine decides whether an order is allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "action",
    "rationale"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "action": {
      "enum": [
        "buy",
        "sell",
        "no_trade"
      ]
    },
    "qty": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]{1,8})?$"
    },
    "limit_price": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]{1,8})?$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string",
      "maxLength": 500
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "buy",
              "sell"
            ]
          }
        }
      },
      "then": {
        "required": [
          "qty",
          "limit_price"
        ]
      }
    }
  ]
}
