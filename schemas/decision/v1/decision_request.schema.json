{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-core.local/schemas/decision/v1/decision_request.schema.json",
  "title": "DecisionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "ts_ns",
    "instrument",
    "best_bid",
    "best_ask",
    "mid",
    "spread_ticks",
    "features",
    "signal",
    "position",
    "limits",
    "allowed_actions"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "ts_ns": {
      "type": "integer",
      "minimum": 0
    },
    "instrument": {
      "type": "string"
    },
    "best_bid": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]{1,8})?$"
    },
    "best_ask": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]{1,8})?$"
    },
    "mid": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]{1,8})?$"
    },
    "spread_ticks": {
      "type": "integer",
      "minimum": 0
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "signal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direction",
            "probs",
            "model_sha256"
          ],
          "properties": {
            "direction": {
              "enum": [
                "up",
                "flat",
                "down"
              ]
            },
            "probs": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 3,
              "maxItems": 3
            },
            "model_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "position": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]{1,8})?$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_position",
        "max_notional",
        "max_order_rate_per_sec",
        "remaining_daily_loss"
      ],
      "properties": {
        "max_position": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]{1,8})?$"
        },
        "max_notional": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]{1,8})?$"
        },
        "max_order_rate_per_sec": {
          "type": "integer",
          "minimum": 0
        },
        "remaining_daily_loss": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]{1,8})?$"
        }
      }
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "enum": [
          "buy",
          "sell",
          "no_trade"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    }
  }
}
