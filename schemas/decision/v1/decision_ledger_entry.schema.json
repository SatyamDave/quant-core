{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-core.local/schemas/decision/v1/decision_ledger_entry.schema.json",
  "title": "DecisionLedgerEntry",
  "type": "object",
  "required": [
    "request",
    "decision",
    "mode",
    "prompt_version",
    "model"
  ],
  "properties": {
    "request": {
      "$ref": "decision_request.schema.json"
    },
    "decision": {
      "$ref": "decision.schema.json"
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "intent_result.schema.json"
        }
      ]
    },
    "mode": {
      "enum": [
        "fake",
        "live",
        "replay"
      ]
    },
    "prompt_version": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "raw": {
      "description": "Full SDK request/response in live mode; null in fake mode."
    },
    "cost_usd": {
      "type": "string",
      "description": "Decimal string (never a JSON number -- root CLAUDE.md 'no floats for money'), same convention as every other money field on the wire. Wave 2 (gateway-integration): was a JSON number through wave 1.",
      "pattern": "^[0-9]+(\\.[0-9]{1,8})?$"
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    }
  }
}
