{
  "name": "@quant-core/agent-service",
  "version": "0.1.0",
  "private": true,
  "description": "Agent SDK decision service: pulls a DecisionRequest from qc-bridge, decides trade/no_trade, submits back, appends the decision ledger.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx src/cli.ts",
    "mcp": "tsx src/control/mcp-server.ts",
    "control-api": "tsx src/control/http-server.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "ajv": "8.20.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
