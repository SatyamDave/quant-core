# Template for /etc/quant-core/live.env on the live host (#63). Copy it there, fill in the
# non-secret values, and load the secret value via QC_SECRETS_PROVIDER (see
# ops/live/README.md's Secrets section) -- never write a real secret into this file or any file
# tracked by git. This example file itself contains no real values.

# The agent service is the one process supervisor.py starts (`npm start` -> `tsx src/cli.ts`,
# per agent/package.json); it spawns its own qc-bridge child using the two variables below
# (agent/src/cli.ts, agent/src/bridge.ts) -- supervisor.py never needs a --bridge-cmd of its own
# for this topology (see its module docstring).
QC_AGENT_CMD="npx --prefix /opt/quant-core/agent tsx src/cli.ts"
QC_BRIDGE_BIN="/opt/quant-core/engine/target/release/qc-bridge"
# `just live-canary SYMBOL` (scripts/ops/live_canary.py) sets QC_BRIDGE_ARGS, QC_AGENT_MODE,
# QC_INSTRUMENT and QC_ASSET_CLASS itself: `<recording> --follow --venue external --instrument
# config/instruments/<symbol>.toml --kill-file ops/live/state/KILL --decide-every 900`, mode
# openrouter. Set them here only for the systemd unit, to the same values:
# --decide-every 900 is one decision per ~15 min at 1 s polls (~26 per trading day), so a free
# model's daily request limit is not exceeded; scripts/shadow/run.py uses the same value.
QC_BRIDGE_ARGS=""
QC_AGENT_MODE="openrouter"
QC_INSTRUMENT=""
QC_ASSET_CLASS="equity"

# Your broker adapter module (agent/src/broker/README.md); the recorder and the gateway both
# load it. It reads its own broker credentials from your secret manager, never from this file.
QC_BROKER_MODULE=""

# OpenRouter decider (ADR-0042). The key is a secret: fill it in on the host only. The model is
# an id ending in ":free"; QC_OPENROUTER_MAX_USD_PER_DAY stays unset (0) for a free model.
OPENROUTER_API_KEY=""
QC_OPENROUTER_MODEL=""
# QC_OPENROUTER_MAX_USD_PER_DAY="0"

# Selects ops/live/bin/load-secrets.sh's provider: env (default), 1password, aws-secrets-manager,
# keychain. Only "env" is implemented in this build; the others are documented, not wired up.
QC_SECRETS_PROVIDER="env"

# The secret itself. Never set a real value here in a file tracked by git -- on the
# real host this file lives outside the repo (/etc/quant-core/live.env, mode 0600, owned by the
# quant-live service user) and is filled in by whatever QC_SECRETS_PROVIDER names.
# Claude decider only (QC_AGENT_MODE=live); the openrouter canary never reads it.
ANTHROPIC_API_KEY=""

# Optional: how long an emulated IOC order (sent to the broker as a day limit order) rests
# before the gateway cancels it, 1-60000 ms. Unset means 2000.
# QC_IOC_CANCEL_AFTER_MS="2000"

# Alert checker (#64), run separately from a systemd timer or cron -- see scripts/ops/alerts.py.
QC_DAILY_SPEND_CAP_USD="5.00"
